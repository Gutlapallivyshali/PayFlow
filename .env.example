# PayFlow Environment Configuration
# Copy this file to .env and replace the placeholder values.

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

DB_NAME=payflow_db
DB_USERNAME=your_db_username
DB_PASSWORD=replace_with_your_local_database_password
DB_URL=jdbc:postgresql://localhost:5432/payflow_db

JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
JWT_EXPIRATION_MS=86400000

MOCK_GATEWAY_LATENCY_MS=150
MOCK_GATEWAY_FORCE_FAILURE=false

VITE_API_URL=http://localhost:8080
